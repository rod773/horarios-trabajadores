# Recommended for most uses
DATABASE_URL=postgresql://user:password@host:5432/db?channel_binding=require&sslmode=require

# For uses requiring a connection without pgbouncer
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/db?sslmode=require

# Parameters for constructing your own connection string
PGHOST=your-host-pooler.region.provider.tech
PGHOST_UNPOOLED=your-host.region.provider.tech
PGUSER=your_user
PGDATABASE=your_db
PGPASSWORD=your_password

# Parameters for Vercel Postgres Templates
POSTGRES_URL=postgresql://user:password@host-pooler.region.provider.tech/db?channel_binding=require&sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://user:password@host.region.provider.tech/db?channel_binding=require&sslmode=require
POSTGRES_USER=your_user
POSTGRES_HOST=your-host-pooler.region.provider.tech
POSTGRES_PASSWORD=your_password
POSTGRES_DATABASE=your_db
POSTGRES_URL_NO_SSL=postgresql://user:password@host.region.provider.tech/db
POSTGRES_PRISMA_URL=postgresql://user:password@host-pooler.region.provider.tech/db?channel_binding=require&connect_timeout=15&sslmode=require

# JWT secret for authentication tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="your-jwt-secret-here"
